{
  "$id": "aida.c03.managed-runtime-source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "source", "selection", "application", "package", "launch", "materialization"],
  "properties": {
    "schema": { "const": "aida.c03.managed-runtime-source" },
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_relative_root", "sdk_version", "sdk_usage", "runtime_framework", "runtime_version", "runtime_identifier"],
      "properties": {
        "repository_relative_root": { "const": ".deps/dotnet-sdk-10.0.301-win-x64" },
        "sdk_version": { "const": "10.0.301" },
        "sdk_usage": { "const": "build_only" },
        "runtime_framework": { "const": "Microsoft.NETCore.App" },
        "runtime_version": { "const": "10.0.9" },
        "runtime_identifier": { "const": "win-x64" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["individual_files", "directory", "directory_file_count", "file_count", "total_size_bytes", "canonical_inventory_sha256", "canonical_inventory_format"],
      "properties": {
        "individual_files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "prefixItems": [
            { "const": "dotnet.exe" },
            { "const": "LICENSE.txt" },
            { "const": "ThirdPartyNotices.txt" },
            { "const": "host/fxr/10.0.9/hostfxr.dll" }
          ],
          "items": false
        },
        "directory": { "const": "shared/Microsoft.NETCore.App/10.0.9" },
        "directory_file_count": { "const": 189 },
        "file_count": { "const": 193 },
        "total_size_bytes": { "const": 80344570 },
        "canonical_inventory_sha256": { "const": "20687edbe0abc5020387ed0f6bdaef85d4ed91529bc356a99510150032af2fe5" },
        "canonical_inventory_format": { "const": "relative-path-tab-size-tab-sha256-newline" }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_framework", "files", "exact_inventory"],
      "properties": {
        "target_framework": { "const": "net10.0" },
        "files": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            { "$ref": "#/$defs/apphost" },
            { "$ref": "#/$defs/assembly" },
            { "$ref": "#/$defs/deps" },
            { "$ref": "#/$defs/runtimeconfig" },
            { "$ref": "#/$defs/provider" },
            { "$ref": "#/$defs/immutable" },
            { "$ref": "#/$defs/metadata" }
          ],
          "items": false
        },
        "exact_inventory": { "const": true }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_relative_root", "manifest_relative_path", "digest_relative_path", "exact_inventory", "sdk_files_forbidden", "nuget_packages_forbidden", "source_files_forbidden"],
      "properties": {
        "runtime_relative_root": { "const": "deps/dotnet" },
        "manifest_relative_path": { "const": "deps/AiDA_ManagedRuntime.manifest.json" },
        "digest_relative_path": { "const": "deps/AiDA_ManagedRuntime.manifest.sha256" },
        "exact_inventory": { "const": true },
        "sdk_files_forbidden": { "const": true },
        "nuget_packages_forbidden": { "const": true },
        "source_files_forbidden": { "const": true }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable_relative_path", "hostfxr_relative_path", "dotnet_root_relative_path", "multilevel_lookup", "roll_forward", "roll_forward_to_prerelease", "machine_runtime_fallback"],
      "properties": {
        "executable_relative_path": { "const": "deps/AiDA_ManagedDecompilerWorker.exe" },
        "hostfxr_relative_path": { "const": "deps/dotnet/host/fxr/10.0.9/hostfxr.dll" },
        "dotnet_root_relative_path": { "const": "deps/dotnet" },
        "multilevel_lookup": { "const": false },
        "roll_forward": { "const": "Disable" },
        "roll_forward_to_prerelease": { "const": false },
        "machine_runtime_fallback": { "const": false }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "copy_mode", "reparse_points_forbidden", "verify_after_copy", "network_fetch_forbidden"],
      "properties": {
        "hash_algorithm": { "const": "sha256" },
        "copy_mode": { "const": "atomic" },
        "reparse_points_forbidden": { "const": true },
        "verify_after_copy": { "const": true },
        "network_fetch_forbidden": { "const": true }
      }
    }
  },
  "$defs": {
    "apphost": { "const": { "role": "apphost", "relative_path": "deps/AiDA_ManagedDecompilerWorker.exe" } },
    "assembly": { "const": { "role": "assembly", "relative_path": "deps/AiDA_ManagedDecompilerWorker.dll" } },
    "deps": { "const": { "role": "deps", "relative_path": "deps/AiDA_ManagedDecompilerWorker.deps.json" } },
    "runtimeconfig": { "const": { "role": "runtimeconfig", "relative_path": "deps/AiDA_ManagedDecompilerWorker.runtimeconfig.json" } },
    "provider": { "const": { "role": "provider", "relative_path": "deps/ICSharpCode.Decompiler.dll" } },
    "immutable": { "const": { "role": "direct_dependency", "relative_path": "deps/System.Collections.Immutable.dll" } },
    "metadata": { "const": { "role": "direct_dependency", "relative_path": "deps/System.Reflection.Metadata.dll" } }
  }
}

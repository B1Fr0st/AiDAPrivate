{
  "$id": "aida.c03.worker-runtime-acl-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "policy", "app_container_profile", "app_container_sid", "worker_manifest_sha256", "protected_parent_required", "access", "path_count", "verified"],
  "properties": {
    "schema": { "const": "aida.c03.worker-runtime-acl-receipt" },
    "schema_version": { "const": 1 },
    "policy": { "enum": ["native", "managed", "analysis_python"] },
    "app_container_profile": { "type": "string", "pattern": "^AiDA\\.NativeWorker\\.[0-9a-f]{32}$" },
    "app_container_sid": { "type": "string", "pattern": "^S-1-15-2-[0-9-]+$" },
    "worker_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "protected_parent_required": { "const": true },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_execute", "write", "delete", "change_permissions", "take_ownership"],
      "properties": {
        "read_execute": { "const": true },
        "write": { "const": false },
        "delete": { "const": false },
        "change_permissions": { "const": false },
        "take_ownership": { "const": false }
      }
    },
    "path_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "verified": { "const": true }
  }
}

{
  "$id": "aida.c03.ghidra-spec-source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "producer", "specifications", "package", "materialization"],
  "properties": {
    "schema": { "const": "aida.c03.ghidra-spec-source" },
    "schema_version": { "const": 1 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "usage", "network_fetch_forbidden", "approved_input_root_required", "approved_generator_root_required"],
      "properties": {
        "id": { "const": "ghidra_sleigh_compiler" },
        "usage": { "const": "build_only" },
        "network_fetch_forbidden": { "const": true },
        "approved_input_root_required": { "const": true },
        "approved_generator_root_required": { "const": true }
      }
    },
    "specifications": {
      "type": "array",
      "minItems": 51,
      "maxItems": 51,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 5, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+\\.(?:sla|pspec|cspec|ldefs)$" },
          "kind": { "enum": ["sla", "pspec", "cspec", "ldefs"] }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirrors", "manifest_relative_path", "digest_relative_path", "exact_inventory", "mixed_generation_forbidden", "unexpected_files_forbidden"],
      "properties": {
        "mirrors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [{ "const": "ghidra_specs" }, { "const": "deps/ghidra_specs" }],
          "items": false
        },
        "manifest_relative_path": { "const": "deps/AiDA_GhidraSpecs.manifest.json" },
        "digest_relative_path": { "const": "deps/AiDA_GhidraSpecs.manifest.sha256" },
        "exact_inventory": { "const": true },
        "mixed_generation_forbidden": { "const": true },
        "unexpected_files_forbidden": { "const": true }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "copy_mode", "reparse_points_forbidden", "verify_after_copy", "network_fetch_forbidden"],
      "properties": {
        "hash_algorithm": { "const": "sha256" },
        "copy_mode": { "const": "atomic" },
        "reparse_points_forbidden": { "const": true },
        "verify_after_copy": { "const": true },
        "network_fetch_forbidden": { "const": true }
      }
    }
  }
}

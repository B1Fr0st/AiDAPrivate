{
  "$id": "aida.c03.managed-runtime-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "source_contract_sha256", "target_framework", "runtime", "application", "launch", "inventory"],
  "properties": {
    "schema": { "const": "aida.c03.managed-runtime-manifest" },
    "schema_version": { "const": 1 },
    "source_contract_sha256": { "$ref": "#/$defs/sha256" },
    "target_framework": { "const": "net10.0" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "version", "runtime_identifier", "relative_root", "exact_inventory", "file_count", "total_size_bytes", "canonical_inventory_sha256", "files"],
      "properties": {
        "framework": { "const": "Microsoft.NETCore.App" },
        "version": { "const": "10.0.9" },
        "runtime_identifier": { "const": "win-x64" },
        "relative_root": { "const": "deps/dotnet" },
        "exact_inventory": { "const": true },
        "file_count": { "const": 193 },
        "total_size_bytes": { "const": 80344570 },
        "canonical_inventory_sha256": { "const": "8582bda52b66ad61651a2c9bc2c705cf10b038e374f87662045397c7966b02c9" },
        "files": { "type": "array", "minItems": 193, "maxItems": 193, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_inventory", "files"],
      "properties": {
        "exact_inventory": { "const": true },
        "files": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/application_file" } }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable_relative_path", "hostfxr_relative_path", "dotnet_root_relative_path", "multilevel_lookup", "roll_forward", "roll_forward_to_prerelease", "machine_runtime_fallback"],
      "properties": {
        "executable_relative_path": { "const": "deps/AiDA_ManagedDecompilerWorker.exe" },
        "hostfxr_relative_path": { "const": "deps/dotnet/host/fxr/10.0.9/hostfxr.dll" },
        "dotnet_root_relative_path": { "const": "deps/dotnet" },
        "multilevel_lookup": { "const": false },
        "roll_forward": { "const": "Disable" },
        "roll_forward_to_prerelease": { "const": false },
        "machine_runtime_fallback": { "const": false }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "total_size_bytes", "canonical_inventory_sha256"],
      "properties": {
        "file_count": { "const": 200 },
        "total_size_bytes": { "type": "integer", "minimum": 80344577, "maximum": 1073741824 },
        "canonical_inventory_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relative_path": { "type": "string", "minLength": 1, "maxLength": 32768, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)(?!.*:)[^\\u0000]+$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "size_bytes", "sha256"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/relative_path" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "application_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "relative_path", "size_bytes", "sha256"],
      "properties": {
        "role": { "enum": ["apphost", "assembly", "deps", "runtimeconfig", "provider", "direct_dependency"] },
        "relative_path": { "$ref": "#/$defs/relative_path" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

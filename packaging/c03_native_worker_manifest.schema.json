{
  "$id": "aida.c03.native-worker-manifest-source.schema.json",
  "title": "AiDA C03 Native Decompiler Worker Manifest Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "artifact", "worker", "materialization"],
  "properties": {
    "schema": { "const": "aida.c03.native-worker-manifest-source" },
    "schema_version": { "const": 2 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "magic", "byte_order", "schema_version", "relative_path", "digest_relative_path", "digest_format"],
      "properties": {
        "format": { "const": "aida.native-worker-manifest" },
        "magic": { "const": "NWMF" },
        "byte_order": { "const": "little-endian" },
        "schema_version": { "const": 2 },
        "relative_path": { "const": "deps/AiDA_NativeDecompilerWorker.manifest.bin" },
        "digest_relative_path": { "const": "deps/AiDA_NativeDecompilerWorker.manifest.sha256" },
        "digest_format": { "const": "lowercase-hex-newline" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "provider", "protocol", "capabilities", "startup_arguments"],
      "properties": {
        "relative_path": { "const": "deps/AiDA_NativeDecompilerWorker.exe" },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "version", "worker_build_id", "worker_build_hash_material"],
          "properties": {
            "id": { "const": 1 },
            "name": { "const": "aida-native-decompiler" },
            "version": { "const": "2" },
            "worker_build_id": { "const": "aida-native-decompiler-worker-v3" },
            "worker_build_hash_material": { "const": "aida-native-decompiler-worker-build-v3|bounded-printc-evidence" }
          }
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "hash_material"],
          "properties": {
            "version": { "const": 3 },
            "hash_material": { "const": "aida.isolated-decompiler.worker.frame.v3|bootstrap.v1|hmac-sha256|strict-sequence|readonly-provider-input|attested-provider-artifacts|bounded-native-printc-evidence|control-frame-8m|result-frame-80m|provider-artifacts-48m|printc-8m" }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "const": "decompile" }],
          "items": false
        },
        "startup_arguments": { "type": "array", "maxItems": 0 }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_lock", "atomic_write", "verify_after_write"],
      "properties": {
        "worker_binary_hash": {
          "description": "SHA-256 hex digest of the staged worker binary. Computed at build time by c03_native_worker_manifest.py. Empty string in source manifest; populated with 64-character lowercase hex digest after build.",
          "oneOf": [
            { "const": "" },
            { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          ]
        },
        "provider_binary_hash": {
          "description": "SHA-256 hex digest of the staged provider binary. Computed at build time by c03_native_worker_manifest.py. Empty string in source manifest; populated with 64-character lowercase hex digest after build.",
          "oneOf": [
            { "const": "" },
            { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          ]
        },
        "manifest_digest": {
          "description": "SHA-256 hex digest of the emitted manifest binary. Computed at build time by c03_native_worker_manifest.py. Empty string in source manifest; populated with 64-character lowercase hex digest after build.",
          "oneOf": [
            { "const": "" },
            { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          ]
        },
        "worker_lock": { "const": "deny-write-and-delete-while-hashing" },
        "atomic_write": { "const": true },
        "verify_after_write": { "const": true }
      }
    }
  }
}

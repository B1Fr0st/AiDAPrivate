#include "provider_snapshot_harness.hpp"

#include <Windows.h>

#include <exception>
#include <filesystem>
#include <iostream>
#include <string>
#include <system_error>

int main()
{
    std::filesystem::path root;
    std::error_code cleanup_error;
    try {
        root = std::filesystem::temp_directory_path() /
            ("aida-c03-provider-snapshot-" + std::to_string(::GetCurrentProcessId()));
        std::filesystem::remove_all(root, cleanup_error);
        aida::analysis::c03::test::run_provider_snapshot_harness(root);
        std::filesystem::remove_all(root, cleanup_error);
        std::cout << "provider_snapshot_harness source contract satisfied\n";
        return 0;
    } catch (const std::exception& error) {
        std::filesystem::remove_all(root, cleanup_error);
        std::cerr << error.what() << '\n';
        return 1;
    }
}

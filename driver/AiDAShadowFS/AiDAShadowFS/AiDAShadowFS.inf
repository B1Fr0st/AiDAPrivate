[Version]
Signature   = "$WINDOWS NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %ProviderString%
DriverVer   = 05/17/2026,1.0.0.0
CatalogFile = AiDAShadowFS.cat
PnpLockdown = 1

[SourceDisksFiles]
AiDAShadowFS.sys = 1,,

[SourceDisksNames]
1 = %DiskId1%,,,

[DestinationDirs]
DefaultDestDir = 12
AiDAShadowFS.DriverFiles = 12

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDescription%
CopyFiles  = AiDAShadowFS.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,,AiDAShadowFS.Service

[DefaultUninstall.NTamd64]
LegacyUninstall = 1
DelFiles        = AiDAShadowFS.DriverFiles

[DefaultUninstall.NTamd64.Services]
DelService = %ServiceName%,0x200

[AiDAShadowFS.Service]
DisplayName      = %ServiceName%
Description      = %ServiceDescription%
ServiceBinary    = %12%\AiDAShadowFS.sys
Dependencies     = "FltMgr"
ServiceType      = 2
StartType        = 3
ErrorControl     = 1
LoadOrderGroup   = "FSFilter Activity Monitor"
AddReg           = AiDAShadowFS.AddRegistry

[AiDAShadowFS.AddRegistry]
HKR,,"DebugFlags",0x00010001,0x0
HKR,,"SupportedFeatures",0x00010001,0x3
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%Instance1.Name%,"Altitude",0x00000000,%Instance1.Altitude%
HKR,"Instances\"%Instance1.Name%,"Flags",0x00010001,%Instance1.Flags%

[AiDAShadowFS.DriverFiles]
AiDAShadowFS.sys

[Strings]
ProviderString       = "AiDA Project"
ServiceName          = "AiDAShadowFS"
ServiceDescription   = "AiDA Shadow Filesystem Minifilter"
DiskId1              = "AiDA Shadow Filesystem Installation Disk"
DefaultInstance      = "AiDAShadowFS Instance"
Instance1.Name       = "AiDAShadowFS Instance"
Instance1.Altitude   = "385701"
Instance1.Flags      = "0x0"

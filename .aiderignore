# ==========================================
# 1. BASE RULES (These MUST come first)
# ==========================================
# Block everything by default
/*

# Allow the specific root directories you want
!/src/
!/driver/
!/server/

# Allow essential project configuration files
!.gitignore
!.aider*
!CMakeLists.txt

# ==========================================
# 2. EXCLUSIONS (These override the allows)
# ==========================================

# Images and Media
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.wav

# Compiled Libs and Binaries
*.lib
*.dll
*.exe
*.pdb
*.obj
*.sys
*.ilk
*.user
*.suo
*.sdf
*.opensdf
*.vcxproj.user

# Dependencies & Build Artifacts
**/node_modules/
**/packages/
**/artifacts/
**/obj/
**/bin/
**/build/
/.deps/
/.cache/
/dist/
__pycache__/
*.py[cod]
.venv/
vcpkg_installed/
compile_commands.json

# IDEs & Environments
.vs/
.idea/
.vscode/

# Secrets
.env
*.pem
*.p12
server/keys/
firebase/functions/.local-secrets/

# Aider and local cache
models.json
license-validation-response.json

# Massive Third-Party Headers/Directories
/src/freetype/
**/stb_image.h

# Asset Byte Arrays (Using ** to catch them anywhere)
**/assets/
**/theme_icons/
**/aidalogo.c
**/background.c

# Excluded Project Roots
/bot/
/camoufox-reverse-mcp/
/firebase/
/ida-sdk/
/libdecomp/
/libs/
/malware_checker/
/mapper/
/stealer/
/tools/

# Excluded specific files
/perception_analysis.md
/vganalysis.md
/win10afd.md
/win11_24h2_afd.md
/win11_25h2_afd.md
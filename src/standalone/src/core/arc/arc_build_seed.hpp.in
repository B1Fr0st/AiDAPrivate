#pragma once

#include <windows.h>

#include <array>
#include <cstdint>
#include <cstring>

#include <openssl/evp.h>
#include <openssl/kdf.h>
#include <openssl/core_names.h>
#include <openssl/params.h>

namespace arc_internal {

    inline constexpr uint8_t k_arc_build_seed_bytes[32] = {
@AIDA_ARC_BUILD_SEED_BYTES@
    };

    inline constexpr uint8_t k_arc_build_commitment[32] = {
@AIDA_ARC_BUILD_COMMITMENT_BYTES@
    };

    inline void arc_build_seed_bytes(uint8_t out[32]) noexcept
    {
        std::memcpy(out, k_arc_build_seed_bytes, 32);
    }

    inline void arc_build_commitment_bytes(uint8_t out[32]) noexcept
    {
        std::memcpy(out, k_arc_build_commitment, 32);
    }

    inline std::array<uint8_t, 64> arc_build_subkey_bytes(const char* domain) noexcept
    {
        std::array<uint8_t, 64> okm{};
        if (!domain) return okm;

        EVP_KDF* kdf = EVP_KDF_fetch(nullptr, "HKDF", nullptr);
        if (!kdf) return okm;
        EVP_KDF_CTX* ctx = EVP_KDF_CTX_new(kdf);
        EVP_KDF_free(kdf);
        if (!ctx) return okm;

        char digest_name[] = "SHA512";
        OSSL_PARAM params[4];
        int idx = 0;
        params[idx++] = OSSL_PARAM_construct_utf8_string(OSSL_KDF_PARAM_DIGEST, digest_name, 0);
        params[idx++] = OSSL_PARAM_construct_octet_string(OSSL_KDF_PARAM_KEY,
            const_cast<uint8_t*>(k_arc_build_seed_bytes), sizeof(k_arc_build_seed_bytes));
        size_t domain_len = std::strlen(domain);
        params[idx++] = OSSL_PARAM_construct_octet_string(OSSL_KDF_PARAM_INFO,
            const_cast<char*>(domain), domain_len);
        params[idx] = OSSL_PARAM_construct_end();

        if (EVP_KDF_derive(ctx, okm.data(), okm.size(), params) <= 0)
        {
            SecureZeroMemory(okm.data(), okm.size());
        }
        EVP_KDF_CTX_free(ctx);
        return okm;
    }

    inline uint64_t arc_build_subkey(const char* domain) noexcept
    {
        auto okm = arc_build_subkey_bytes(domain);
        uint64_t v = 0;
        std::memcpy(&v, okm.data(), sizeof(v));
        SecureZeroMemory(okm.data(), okm.size());
        return v;
    }

}

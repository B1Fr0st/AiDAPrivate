#pragma once

#include <cstdint>

namespace arc_internal {

    constexpr uint64_t arc_build_seed() noexcept {
        return 0x@AIDA_ARC_BUILD_SEED@ULL;
    }

    constexpr uint64_t arc_build_subkey(uint64_t domain) noexcept {
        uint64_t z = arc_build_seed() + domain * 0x9E3779B97F4A7C15ULL;
        z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
        z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
        z = z ^ (z >> 31);
        return z;
    }

}

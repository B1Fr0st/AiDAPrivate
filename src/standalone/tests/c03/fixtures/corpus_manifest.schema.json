{
  "$id": "aida.c03.corpus-manifest.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "corpus_id", "license_policy", "generator_source", "materializer_source", "ground_truth_source", "target_execution_forbidden", "fixture_defaults", "required_coverage", "fixtures", "malformed_case_manifest"],
  "properties": {
    "schema": {"const": "aida.c03.corpus-manifest"},
    "schema_version": {"const": 2},
    "corpus_id": {"type": "string", "minLength": 1},
    "license_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_spdx", "redistribution_required"],
      "properties": {
        "allowed_spdx": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "redistribution_required": {"const": true}
      }
    },
    "generator_source": {"$ref": "#/definitions/source"},
    "materializer_source": {"$ref": "#/definitions/source"},
    "ground_truth_source": {"$ref": "#/definitions/source"},
    "target_execution_forbidden": {"const": true},
    "fixture_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license", "artifact_binding", "semantic_facts", "evidence_domains", "resource_limits"],
      "properties": {
        "source": {"type": "object"},
        "license": {"type": "object"},
        "artifact_binding": {"type": "object"},
        "semantic_facts": {"type": "object"},
        "evidence_domains": {"type": "array"},
        "resource_limits": {"type": "object"}
      }
    },
    "required_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "architectures", "evidence_domains"],
      "properties": {
        "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_domains": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/fixture"}},
    "malformed_case_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "license"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format", "architecture", "architecture_identity", "mode", "endian"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator", "sha256"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "locator": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/definitions/sha256"}
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "redistribution"],
          "properties": {"spdx": {"type": "string", "minLength": 1}, "redistribution": {"const": true}}
        },
        "artifact_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "algorithm", "content_hash_required", "recipes_sha256", "materializer_sha256", "ground_truth_sha256"],
          "properties": {
            "status": {"const": "deterministic_recipe"},
            "algorithm": {"const": "sha256"},
            "content_hash_required": {"const": true},
            "recipes_sha256": {"$ref": "#/definitions/sha256"},
            "materializer_sha256": {"$ref": "#/definitions/sha256"},
            "ground_truth_sha256": {"$ref": "#/definitions/sha256"}
          }
        },
        "format": {"type": "string", "minLength": 1},
        "container_chain": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "architecture": {"type": "string", "minLength": 1},
        "architecture_identity": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "endian": {"type": "string", "minLength": 1},
        "semantic_facts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity_kinds", "edge_kinds", "metadata_kinds", "identity_kind", "facts_revision"],
          "properties": {
            "entity_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "edge_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "metadata_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "identity_kind": {"type": "string", "minLength": 1},
            "facts_revision": {"type": "integer", "minimum": 1}
          }
        },
        "evidence_domains": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "resource_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_input_bytes", "max_private_bytes", "max_mapped_bytes", "max_wall_ms"],
          "properties": {
            "max_input_bytes": {"type": "integer", "minimum": 1},
            "max_private_bytes": {"type": "integer", "minimum": 1},
            "max_mapped_bytes": {"type": "integer", "minimum": 1},
            "max_wall_ms": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aida://standalone/ui-parity/v1",
  "title": "AiDA Standalone human UI parity authority",
  "type": "object",
  "required": ["schema_version", "authority", "gates", "inventory"],
  "properties": {
    "schema_version": {"const": 1},
    "authority": {
      "type": "object",
      "required": ["scope", "source_root", "target_id_prefixes"],
      "properties": {
        "scope": {"const": "standalone_human_ui"},
        "source_root": {"const": "src/standalone/src"},
        "target_id_prefixes": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "required": ["G1", "G2", "G3", "G4", "G5"],
      "additionalProperties": {"type": "object"}
    },
    "inventory": {
      "type": "array",
      "minItems": 120,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "stable_id", "target_id", "kind", "label", "workspace", "category",
        "source_path", "source_symbol", "current_status", "disposition",
        "migration_status", "parity_requirements"
      ],
      "properties": {
        "stable_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "target_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "kind": {"type": "string", "minLength": 2},
        "label": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "minLength": 2},
        "category": {"type": "string", "minLength": 2},
        "source_path": {"type": "string", "pattern": "^src/standalone/src/"},
        "source_symbol": {"type": "string", "minLength": 2},
        "current_status": {"enum": ["reachable", "partial", "alias", "unreachable", "backend_only"]},
        "disposition": {"enum": ["preserve", "migrate", "activate", "parity_replace", "capability_gate", "retire_after_parity"]},
        "migration_status": {"enum": ["inventoried", "target_defined", "gated", "runtime_pending", "implemented"]},
        "parity_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 4}
        },
        "aliases": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

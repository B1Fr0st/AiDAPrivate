# 1. Ignore everything by default
/*

# 2. Allow root project files (CMakeLists.txt, .cpp, etc)
!/*.*

# 3. Allow AIDA Source
!/src/
!/src/**

# 4. Allow specific VMProtect Include files
!/VMProtect3.9.4/
!/VMProtect3.9.4/Include/
!/VMProtect3.9.4/Include/**

# 5. Allow IDA SDK Include files
!/ida-sdk/
!/ida-sdk/src/
!/ida-sdk/src/include/
!/ida-sdk/src/include/**

# 6. Allow Libs folder
!/libs/
!/libs/**

# 7. Allow ONLY the specific pe_protect script in tools
!/tools/
!/tools/pe_protect.py

# 9. Allow driver folder
!/driver/
!/driver/**

# 8. Hard Exclusions (Noise/Binary/Build artifacts)
**/node_modules/**
**/build/**
**/CMakeFiles/**
**/Release/**
**/Debug/**
**/.git/**
**/.vscode/**
**/*.tlog
**/*.db
**/*.rep
**/*.exe
**/*.dll
**/*.obj
**/*.pdb
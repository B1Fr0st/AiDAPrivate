# ==========================================
# 1. BASE RULES (These MUST come first)
# ==========================================
# Block everything by default
/*

# Allow the specific root directories you want
!/src/
!/server/
!/tools/
!/cmake/
!/docs/

# Allow essential project configuration files
!.gitignore
!.aider*
!CMakeLists.txt
!CLAUDE.md
!AGENTS.md
!build-host.ps1
!build-host.cmd
!CMakePresets.json
!/licenses/
/licenses/*
!/licenses/c03/
!/licenses/c03/**
!/packaging/
/packaging/*
!/packaging/c03_worker_manifest.schema.json
!/packaging/c03_worker_manifest.lock.json
!/packaging/c03_native_worker_manifest.json
!/packaging/c03_native_worker_manifest.schema.json
!/packaging/c03_native_worker_manifest.py
!/packaging/c03_distribution_manifest.schema.json
!/packaging/c03_distribution_manifest.ps1
!/packaging/c03_distribution_manifest_spec.json
!/packaging/c03_distribution_fixture/
!/packaging/c03_distribution_fixture/**
**/.aida-c03-publication-journal.json
**/.aida-c03-signing-provider-*.exe
**/.aida-c03-signer-policy-*.json
!/packaging/c03_worker_runtime/
!/packaging/c03_worker_runtime/**
!/packaging/c03_camoufox_reverse_mcp_build.lock.json

# ==========================================
# 2. EXCLUSIONS (These override the allows)
# ==========================================

# Build-generated embedded headers (regenerated from AiDA.dll; >100MB so exceeds GitHub per-file limit)
/src/aida_plugin_encrypted.h

# Images and Media
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.wav

# Compiled Libs and Binaries
*.lib
*.dll
*.exe
*.pdb
*.obj
*.sys
*.ilk
*.user
*.suo
*.sdf
*.opensdf
*.vcxproj.user

# Dependencies & Build Artifacts
**/node_modules/
**/packages/
**/artifacts/
**/obj/
**/bin/
**/build/
/.cache/
/dist/
__pycache__/
*.py[cod]
.venv/
vcpkg_installed/
compile_commands.json

# IDEs & Environments
.vs/
.idea/

# Secrets
.env
*.pem
*.p12
server/keys/
server/bootstrap_artifacts/
firebase/functions/.local-secrets/

# Aider and local cache
models.json
license-validation-response.json

# Massive Third-Party Headers/Directories
**/freetype/
**/stb_image.h

# Asset Byte Arrays (Using ** to catch them anywhere)
**/assets/
**/theme_icons/
**/aidalogo.c
**/background.c

# Excluded Project Roots
/bot/
/camoufox-reverse-mcp/
/firebase/
/ida-sdk/
/libdecomp/
/libs/
/mapper/
/sources/

# Excluded specific files
/perception_analysis.md
/vganalysis.md
/win10afd.md
/win11_24h2_afd.md
/win11_25h2_afd.md
.aider*

# ============================================================================
# AiDA License Server — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!
# ============================================================================

# PostgreSQL connection string (local on aidapro.net server)
DATABASE_URL=postgresql://aida_api:CHANGEME@localhost:5432/aida_prod

# Ed25519 signing key (base64-encoded PKCS#8 DER private key)
# Generate with: node scripts/generate-keys.js
ED25519_PRIVATE_KEY_B64=

# Server master secret for HMAC-based ARC session encryption key derivation
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARC_MASTER_SECRET=

# Discord webhook for violation/ban logging
DISCORD_WEBHOOK_URL=

# Path to ARC blob on server filesystem
ARC_BLOB_PATH=/opt/aida/arc/aida_core.bin

# Path to AiDA binary for distribution
AIDA_BINARY_PATH=/opt/aida/bin/AiDA.exe

# Server listen port (Nginx reverse-proxies 443 → this)
PORT=3000

# Node environment
NODE_ENV=production

# ============================================================================
# AiDA License Server — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!
# ============================================================================

# PostgreSQL connection string (local on aidapro.net server)
DATABASE_URL=postgresql://aida_api:CHANGEME@localhost:5432/aida_prod

# Ed25519 signing key (base64-encoded PKCS#8 DER private key)
# Generate with: node scripts/generate-keys.js
ED25519_PRIVATE_KEY_B64=

# Server master secret for HMAC-based ARC session encryption key derivation
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARC_MASTER_SECRET=

# Discord webhook for violation/ban logging
DISCORD_WEBHOOK_URL=

# Path to ARC blob on server filesystem
ARC_BLOB_PATH=/opt/aida/arc/aida_core.bin

# Server listen port (Nginx reverse-proxies 443 → this)
PORT=3001

# Node environment
NODE_ENV=production

# CORS origin whitelist (comma-separated); use '*' only for dev
CORS_ORIGIN=https://aidapro.net

# Enforce challenge-response on validate/heartbeat (must remain 1 in production)
CHALLENGE_REQUIRED=1

# HMAC secret for /api/license/challenge signing; falls back to ARC_MASTER_SECRET
CHALLENGE_SIGNING_SECRET=

# TLS-exporter verification (1=reject on mismatch, 0=soft)
TLS_EXPORTER_REQUIRED=0
TLS_EXPORTER_LABEL=aida/v1

# Ed25519 key rotation schedule (epoch seconds; 0=no constraint)
ED25519_KEY_NOT_BEFORE=0
ED25519_NEXT_PUBKEY_B64=
ED25519_NEXT_NOT_BEFORE=0
ED25519_NEXT_NEXT_PUBKEY_B64=
ED25519_NEXT_NEXT_NOT_BEFORE=0

# ARC page-rotation interval (seconds)
ROTATION_INTERVAL_SECONDS=600

# Admin API key for /kill (keep secret; rate-limited 5/hour)
ADMIN_API_KEY=

# Server master key for wrapping install_secret + Kw (base64, 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERVER_MASTER_KEY_B64=

# Sentinel heartbeat ring buffer max entries per license
SENTINEL_RING_MAX=2048

# Client-side Ed25519 public key (base64, 32 raw bytes) used to verify
# /api/telemetry payloads. If empty, signature verification is skipped
# during rollout — set before going live.
CLIENT_TELEMETRY_PUBKEY_B64=

# Discord webhook for client telemetry relay (warn/critical forwarded,
# rate-limited 10/min burst 5, aggregated digest when throttled).
DISCORD_TELEMETRY_WEBHOOK=

# Minimum severity forwarded to Discord (debug|info|warn|critical)
TELEMETRY_FORWARD_MIN_SEVERITY=warn

# Dedicated Discord webhook for RE-detection critical violations
# (post-then-enforce channel, rate-limited 60/min per license).
DISCORD_VIOLATION_WEBHOOK_URL=

# Redis connection URL for per-(license,session) heartbeat rate limiting,
# heartbeat sliding-window regression detection, and server-nonce replay
# protection. Format: redis[s]://[username:password@]host:port[/db].
# When unset, the server falls back to a single-process in-memory store
# suitable only for local dev / unit tests.
REDIS_URL=

# Per-(license, session) heartbeat throttle (seconds). Phase 12.2.1.
HEARTBEAT_MIN_INTERVAL_SECONDS=10

# Sliding-window regression detection (seconds, max events). Phase 12.2.2.
HEARTBEAT_WINDOW_SECONDS=60
HEARTBEAT_WINDOW_MAX_EVENTS=5

# TTL of issued + echoed server nonces in Redis. Phase 12.6.2.
NONCE_REPLAY_TTL_SECONDS=60

# KMS key id (or ARN) used to envelope-encrypt the at-rest column root key.
# - "arn:aws:kms:..." routes to AWS KMS (requires KMS_DATA_KEY_B64 cached).
# - any other value (or empty) routes to the local HSM file.
KMS_KEY_ID=

# Cached AWS KMS data key (base64, 32 bytes). Populated by a boot script
# that calls KMS Decrypt against the wrapped data-key blob; required only
# when KMS_KEY_ID is an AWS ARN.
KMS_DATA_KEY_B64=

# Local HSM file (sodium/scrypt-sealed root key for column encryption).
# Default: <server>/keys/local_hsm.bin. File is created on first boot
# with 0o600 permissions and Windows ACL lockdown.
LOCAL_HSM_PATH=

# Passphrase used to derive the local HSM KEK. Falls back to
# ARC_MASTER_SECRET when unset. Rotate by removing the local_hsm.bin
# file and re-running migrations (existing rows re-wrap automatically).
LOCAL_HSM_PASSPHRASE=

# SHA-256 of the public TLS cert SubjectPublicKeyInfo (SPKI), in lowercase
# hex. Logged at boot for parity with the client's baked pin (the client
# enforces; the server only logs). Use tools/spki_pin/extract_spki_pin.py
# to compute this from the live deployed certificate.
LICENSE_SERVER_SPKI_PIN_HEX=

AIDA_PUBLIC_ORIGIN=https://api.aidapro.net
AIDA_BOOTSTRAP_SCRIPT_PATH=
AIDA_BOOTSTRAP_SCRIPT_SLUG=
AIDA_BOOTSTRAP_ROOT_NEGOTIATION=1
AIDA_BOOTSTRAP_LEGACY_ROUTE_ENABLED=0
AIDA_BOOTSTRAP_SCRIPT_RATE_LIMIT_PER_MINUTE=30
AIDA_BOOTSTRAP_API_RATE_LIMIT_PER_MINUTE=20
AIDA_BOOTSTRAP_ARTIFACT_RATE_LIMIT_PER_10MIN=12
AIDA_BOOTSTRAP_ARTIFACT_URL=
AIDA_BOOTSTRAP_ARTIFACT_SHA256=
AIDA_BOOTSTRAP_ARTIFACT_VERSION=
AIDA_BOOTSTRAP_ARTIFACT_NAME=AiDAStandalone.exe
AIDA_BOOTSTRAP_ARTIFACT_SIZE=
AIDA_BOOTSTRAP_ARTIFACT_FORMAT=encrypted-cbc-hmac-v1
AIDA_BOOTSTRAP_ARTIFACT_DIR=/home/ruarr/aida-server/bootstrap_artifacts
AIDA_BOOTSTRAP_PACKAGE_SHA256=
AIDA_BOOTSTRAP_PACKAGE_SIZE=
AIDA_BOOTSTRAP_PACKAGE_MAX_BYTES=536870912
AIDA_BOOTSTRAP_PACKAGE_ENC_KEY_B64=
AIDA_BOOTSTRAP_PACKAGE_MAC_KEY_B64=
AIDA_BOOTSTRAP_SIGNER_THUMBPRINT=
AIDA_BOOTSTRAP_REQUIRE_AUTHENTICODE=1
AIDA_BOOTSTRAP_ACCEPT_PINNED_PRIVATE_CA_SIGNER=0
AIDA_BOOTSTRAP_REQUIRE_TLS_PIN=1
AIDA_BOOTSTRAP_TLS_CERT_SHA256=
BOOTSTRAP_TOKEN_SECRET_B64=
BOOTSTRAP_TOKEN_TTL_SECONDS=180
BOOTSTRAP_TOKEN_BIND_IP=1

# PostgreSQL data-at-rest TDE is configured at the server / filesystem
# level (e.g. cluster-level pg_tde extension, LUKS, BitLocker). The
# column-level wrapping in column_crypt.js + per-row UUID derivation is
# applied on top, so even a stolen pg_dump or filesystem snapshot leaks
# only ciphertext. See db/migrate.js for the exact order of operations.
